{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:dimensions": "node scripts/test-court-dimensions.mjs",
    "test:photo-preview": "node scripts/test-photo-preview.mjs",
    "test:agenda": "node scripts/test-agenda.mjs",
    "test:availability": "node scripts/test-agenda-availability.mjs",
    "test:calendar": "node scripts/test-reservation-calendar.mjs",
    "test:caja": "node scripts/test-caja.mjs",
    "test:cash-admin": "node scripts/test-cash-box-admin.mjs",
    "test:dashboard": "node scripts/test-dashboard.mjs && node scripts/test-dashboard-destinations.mjs",
    "test:sidebar": "node scripts/test-sidebar.mjs",
    "test:badge": "node scripts/test-badge.mjs",
    "test:catalog-actions": "node scripts/test-catalog-actions.mjs",
    "test:page-header": "node scripts/test-page-header.mjs",
    "test:filters": "node scripts/test-list-toolbar.mjs",
    "test:search-select": "node scripts/test-search-select.mjs",
    "test:reservation-flow": "node scripts/test-reservation-flow.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@fullcalendar/angular": "^6.1.20",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/luxon3": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "bootstrap": "^5.3.8",
    "luxon": "^3.7.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.8",
    "@angular/cli": "^20.3.8",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
